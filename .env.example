# Upstox API credentials — copy this file to .env and fill it in.
#
#   cp .env.example .env
#
# Create an app at https://account.upstox.com/developer/apps to get these.
# .env is gitignored; never commit real credentials.

# --- required to connect ------------------------------------------------
# "API Key" in the Upstox developer console (it is the OAuth client_id).
UPSTOX_API_KEY=

# "API Secret" from the same app. Server-side only — it never reaches the page.
UPSTOX_API_SECRET=

# Must match the Redirect URI registered on the app, character for character.
# For local use, point it at this app's callback route:
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/broker/callback

# --- placing real orders ------------------------------------------------
# Off unless you set this. With it off, instruments in Live mode are still
# simulated — a deliberate second switch beyond simply holding credentials.
UPSTOX_LIVE_TRADING=no

# --- optional -----------------------------------------------------------
# Where the daily access token is cached (chmod 600, gitignored).
UPSTOX_TOKEN_FILE=.upstox-token.json
# Override only if Upstox moves a host.
# UPSTOX_API_BASE=https://api.upstox.com
# UPSTOX_HFT_BASE=https://api-hft.upstox.com
UPSTOX_TIMEOUT_SECONDS=10

# --- the desk itself ----------------------------------------------------
MACD_DESK_PORT=8000
MACD_DESK_HOST=127.0.0.1
MACD_DESK_STATE=desk-state.json
